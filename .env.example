# Copied to .env by you; never committed. The notebook and the bridge read these.
AWS_REGION=us-east-2
AWS_PROFILE=
SAGEMAKER_ENDPOINT=dialog-rsn-1
# Local port the bridge listens on. Your OpenAI Realtime client connects to ws://127.0.0.1:PORT
PORT=8079
# Only needed off SageMaker (a laptop): the execution role the endpoint runs as.
SAGEMAKER_ROLE_ARN=
